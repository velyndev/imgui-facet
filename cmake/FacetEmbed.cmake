# Embeds binary files into a generated C++ source file.
#
# facet_embed_assets(OUTPUT <file.cpp> BASE_DIR <dir> FILES <file>...)
#
# Generates <file.cpp> at build time. It defines facet::internal::EmbeddedAssets()
# (declared in src/internal/embedded_assets.h), which returns one entry per file:
# the path relative to BASE_DIR with forward slashes, a pointer to the bytes and the
# byte count. Every array carries one extra zero byte after the data, so text assets
# such as SVG can be read as a C string. An empty FILES list is valid.
#
# The same file runs in script mode (cmake -P) to do the actual generation.

if(FACET_EMBED_RUN)
    # --- Script mode: FACET_EMBED_RUN, LIST_FILE, BASE_DIR and OUTPUT come from -D ---
    file(STRINGS "${LIST_FILE}" files)
    list(SORT files)

    set(arrays "")
    set(entries "")
    set(index 0)
    foreach(path IN LISTS files)
        file(RELATIVE_PATH name "${BASE_DIR}" "${path}")
        if(name MATCHES "[\"\\\\]")
            message(FATAL_ERROR "Asset path contains a quote or backslash: ${name}")
        endif()
        file(READ "${path}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # CMake regular expressions have no {n} repetition, so spell out 16 bytes per line.
        string(REPEAT "0x..," 16 line_pattern)
        string(REGEX REPLACE "(${line_pattern})" "\\1\n    " bytes "${bytes}")
        string(APPEND arrays
            "// ${name}\n"
            "const unsigned char kAsset${index}[] = {\n    ${bytes}0x00\n};\n\n")
        string(APPEND entries "    {\"${name}\", kAsset${index}, ${size}},\n")
        math(EXPR index "${index} + 1")
    endforeach()

    set(out "// Generated by cmake/FacetEmbed.cmake from the files under assets/. Do not edit.\n")
    string(APPEND out "#include \"internal/embedded_assets.h\"\n\n")
    string(APPEND out "namespace facet::internal\n{\n")
    if(index EQUAL 0)
        string(APPEND out
            "std::span<const EmbeddedAsset> EmbeddedAssets()\n{\n    return {};\n}\n")
    else()
        string(APPEND out "namespace\n{\n${arrays}")
        string(APPEND out "const EmbeddedAsset kAssets[] = {\n${entries}};\n} // namespace\n\n")
        string(APPEND out
            "std::span<const EmbeddedAsset> EmbeddedAssets()\n{\n    return kAssets;\n}\n")
    endif()
    string(APPEND out "} // namespace facet::internal\n")
    file(WRITE "${OUTPUT}" "${out}")
    return()
endif()

set(FACET_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_FILE}" CACHE INTERNAL "")

function(facet_embed_assets)
    cmake_parse_arguments(ARG "" "OUTPUT;BASE_DIR" "FILES" ${ARGN})
    if(NOT ARG_OUTPUT OR NOT ARG_BASE_DIR)
        message(FATAL_ERROR "facet_embed_assets: OUTPUT and BASE_DIR are required")
    endif()

    # The file list goes through a file instead of the command line, which keeps the
    # command short and makes the build rerun the generator when files are added or removed.
    set(list_content "")
    foreach(path IN LISTS ARG_FILES)
        string(APPEND list_content "${path}\n")
    endforeach()
    set(list_file "${ARG_OUTPUT}.list")
    file(CONFIGURE OUTPUT "${list_file}" CONTENT "${list_content}" @ONLY)

    list(LENGTH ARG_FILES count)
    add_custom_command(
        OUTPUT "${ARG_OUTPUT}"
        COMMAND "${CMAKE_COMMAND}"
            -DFACET_EMBED_RUN=1
            "-DLIST_FILE=${list_file}"
            "-DBASE_DIR=${ARG_BASE_DIR}"
            "-DOUTPUT=${ARG_OUTPUT}"
            -P "${FACET_EMBED_SCRIPT}"
        DEPENDS "${list_file}" ${ARG_FILES} "${FACET_EMBED_SCRIPT}"
        COMMENT "Embedding ${count} asset file(s)"
        VERBATIM)
endfunction()
